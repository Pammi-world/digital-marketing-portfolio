          <p>Search engine optimization to boost your rankings</p>
        </div>
        <div class="service-card">
          <h3>Social Media</h3>
          <p>Strategic social media marketing</p>
        </div>
        <div class="service-card">
          <h3>Content</h3>
          <p>Compelling content that converts</p>
        </div>
        <div class="service-card">
          <h3>PPC</h3>
          <p>Pay-per-click advertising campaigns</p>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <p>&copy; 2026 Digital Marketing Portfolio. All rights reserved.</p>
  </footer>
